{
  "manifest_version": 3,
  "name": "TechStack Detector",
  "version": "1.0.0",
  "description": "Deteksi tech stack website secara detail: CMS, ERP (Odoo), framework, backend, server, CDN, UI library, analytics & security headers.",
  "permissions": ["activeTab", "scripting", "storage", "webRequest", "cookies"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TechStack Detector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["inject.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["signatures.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
